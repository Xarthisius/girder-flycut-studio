__pycache__/
*.pyc
*.egg-info/
# Root-anchored: a bare `build/` also matched girder_flycut/web_client/build/,
# silently keeping the source generator out of version control.
/build/
vendor/girder-dashboards/build/
dist/
.pytest_cache/
.venv/

.DS_Store
node_modules/
.env
.env.*
!.env.example
local-backups/

# Required prebuilt frontend for the bundled dashboards dependency.
!vendor/girder-dashboards/girder_dashboards/web_client/dist/
vendor/girder-dashboards/girder_dashboards/web_client/dist/*
!vendor/girder-dashboards/girder_dashboards/web_client/dist/girder-plugin-dashboards.umd.cjs
!vendor/girder-dashboards/girder_dashboards/web_client/dist/style.css

# Coverage output
.coverage
coverage.xml
htmlcov/

# Generated browser sources and the built bundle
girder_flycut/web_client/generated/
girder_flycut/web_client/dist/

# Browser harness artefacts
test/browser/screenshots/
