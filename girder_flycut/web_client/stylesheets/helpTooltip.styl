.g-flycut-dashboard-help
  position fixed
  z-index 10000
  max-width unquote('min(280px,calc(100vw - 20px))')
  padding 10px 12px
  border-radius 8px
  background #18252f
  color #fff
  font 12px/1.5 ui-sans-serif,system-ui,sans-serif
  box-shadow 0 4px 16px #0003
  pointer-events none

.g-flycut-dashboard-help.hidden
  display none
