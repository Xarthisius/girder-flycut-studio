.g-flycut-dashboard
  // - Narrower than the workflow screens it shares a class with, and left
  // - aligned. Written as both classes rather than relying on this file loading
  // - after workflowHome.styl, which is not something a file should have to
  // - know about another.
  .workflow-home.settings-screen
    max-width 800px
    text-align left

  .settings-screen .field
    margin 14px 0

  .settings-screen h2
    margin-top 28px

  .settings-screen ul
    padding-left 20px

  .settings-screen li .button
    margin-left 10px
    padding 3px 8px
