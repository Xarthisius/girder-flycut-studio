// The config page is the dashboard's stylesheet outside the dashboard, so the
// wrapper still carries .g-flycut-dashboard and only the page chrome is here.
// Everything stays nested under that class: tests/bundle.cjs fails if a rule
// escapes it.
.g-flycut-dashboard.g-flycut-config
  padding 0

  // The screen is the whole page here, not one of five the shell swaps
  // between, so it is never hidden and needs no room for a topbar it has not
  // got.
  #adminSettingsScreen
    display block
    margin-top 0

  // Back belongs to the dashboard shell, which this page is not inside.
  #adminSettingsBack
    display none

  .flycut-config-status
    min-height 1.25rem
    margin-bottom 0.5rem
