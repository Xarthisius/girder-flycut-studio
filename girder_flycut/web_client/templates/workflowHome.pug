h1 Choose a module
.workflow-cards.workflow-choices
  button#configurationStepBtn.workflow-choice(type='button')
    span.step-number 01
    strong Configuration
    small Build, edit, or view configurations.
  button#lightburnStepBtn.workflow-choice(type='button')
    span.step-number 02
    strong Generation
    small Generate stack identity files from submitted configs
  button#registerBtn.workflow-choice(type='button')
    span.step-number 03
    strong Registration
    small Register stack IGSN from file identity files.
  button#completeWorkflowBtn.workflow-choice(type='button')
    span.step-number 1–3
    strong Complete Workflow
    small Configure a stack, then submit to generate files and register its IGSN automatically.
