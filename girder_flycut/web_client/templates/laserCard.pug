//- One laser-parameter entry.
//-
//- `overflow` means the template has no layer left for this entry; `unused` is
//- that or switched off. Only overflow disables the checkbox, because the
//- enabled state is restored if the row fits again.
//-
//- `locked` means the entry came from a workbook and still says what that
//- workbook said. Unlocking it, or restoring what it imported, is the one
//- button in the head that is not "remove".

mixin laserField(key, label, attrs)
  label
    | #{label}
    input(data-key=key, value=laser[key], disabled=laser.locked)&attributes(attrs)

article.laser-card(class={unused: unused, 'import-locked': laser.locked}, data-id=laser.id)
  .laser-head
    span.drag-handle(draggable='true', aria-label=`Drag ${laser.name} to reorder`, title='Drag to reorder') ⠿
    i.color-swatch(style=`--swatch:${laser.color}`)
    span.laser-name Layer #{laser.name}
    if laser.isDefault
      span.default-badge Default
    if laser.fromImport
      span.source-badge(class=laser.locked ? '' : 'edited')= laser.locked ? 'From Import' : 'Edited from Import'
    if unused
      span.unused-badge Unused
    if laser.fromImport
      button.lock-btn.toggle-lock(type='button', aria-label=`${laser.locked ? 'Unlock' : 'Restore'} imported parameters`)= laser.locked ? 'Unlock' : 'Restore'
    button.remove-btn.remove-laser(type='button', aria-label='Remove laser setting') ×
  .laser-grid
    label
      | Layer
      input(data-key='name', value=laser.name, readonly, aria-label=`Locked layer name ${laser.name}`)
    .color-field
      span Color
      .color-controls
        input.wheel-editor(type='color', aria-label=`${laser.name} color picker`, value=laser.color, disabled=laser.locked)
        input.hex-editor(type='text', aria-label=`${laser.name} hex color`, value=laser.color, maxlength='7', placeholder='#RRGGBB', spellcheck='false', disabled=laser.locked)
    label.checkbox-field.layer-enabled(class={'overflow-enabled': overflow}, title=overflow ? 'Unused by template; enabled state is restored when this row fits' : '')
      span Enabled
      span.checkbox-control
        input(data-key='enabled', type='checkbox', aria-label=`Enable ${laser.name}`, checked=!overflow && laser.enabled !== false, disabled=overflow || laser.locked)
    +laserField('power', 'Power %', {type: 'number', min: '0', max: '100', step: '0.1'})
    +laserField('speed', 'Speed mm/s', {type: 'number', min: '0.01', step: '0.01'})
    +laserField('qpulsewidth', 'QPulse ns', {type: 'number', min: '0', step: '1'})
    +laserField('frequency', 'Frequency kHz', {type: 'number', min: '0', step: '0.1'})
    +laserField('passes', 'Passes', {type: 'number', min: '1', step: '1'})
